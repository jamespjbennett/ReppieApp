#!/usr/bin/env bash
# Launch, check, and stop the ReppieApp web server used for verification.
# Kills only the process tree this script started. Leaves artifacts/ in place.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ROOT="$(cd "$SKILL_DIR/../../.." && pwd)"
RUN_DIR="$SKILL_DIR/.run"
ARTIFACTS_DIR="$SKILL_DIR/artifacts"
LOG_FILE="$RUN_DIR/expo.log"
PID_FILE="$RUN_DIR/root.pid"
PORT_FILE="$RUN_DIR/port"
URL_FILE="$RUN_DIR/url"

port_free() {
  python3 - "$1" <<'PY'
import socket, sys
port = int(sys.argv[1])
for family, host in ((socket.AF_INET6, "::1"), (socket.AF_INET, "127.0.0.1")):
    sock = socket.socket(family, socket.SOCK_STREAM)
    try:
        sock.bind((host, port))
    except OSError:
        sys.exit(1)
    finally:
        sock.close()
sys.exit(0)
PY
}

pick_port() {
  port=8091
  while [ "$port" -le 8110 ]; do
    if port_free "$port"; then
      echo "$port"
      return 0
    fi
    port=$((port + 1))
  done
  echo "no free port between 8091 and 8110" >&2
  return 1
}

pid_alive() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

read_pid() {
  if [ -f "$PID_FILE" ]; then
    tr -d '[:space:]' < "$PID_FILE"
  fi
}

is_descendant() {
  pid="$1"
  root="$2"
  while [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "1" ]; do
    if [ "$pid" = "$root" ]; then
      return 0
    fi
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)"
  done
  return 1
}

listener_pid() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -n 1
}

expo_version() {
  python3 - "$ROOT/node_modules/expo/package.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))["version"])
PY
}

kill_tree() {
  pid="$1"
  children="$(pgrep -P "$pid" || true)"
  for child in $children; do
    kill_tree "$child"
  done
  kill "$pid" 2>/dev/null || true
}

require_state() {
  if [ ! -f "$PID_FILE" ] || [ ! -f "$PORT_FILE" ] || [ ! -f "$URL_FILE" ]; then
    echo "no verification server recorded at $RUN_DIR" >&2
    return 1
  fi
}

cmd_launch() {
  existing="$(read_pid || true)"
  if pid_alive "$existing"; then
    echo "refusing to start a second server; recorded pid $existing is still alive" >&2
    echo "url=$(tr -d '[:space:]' < "$URL_FILE")" >&2
    exit 1
  fi
  rm -rf "$RUN_DIR"
  mkdir -p "$RUN_DIR" "$ARTIFACTS_DIR"
  port="$(pick_port)"
  echo "$port" > "$PORT_FILE"
  url="http://localhost:$port"
  echo "$url" > "$URL_FILE"
  (
    cd "$ROOT"
    nohup env CI=1 EXPO_NO_TELEMETRY=1 npx expo start --localhost --port "$port" >>"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  )
  root="$(read_pid)"
  ready_log=0
  i=0
  while [ "$i" -lt 60 ]; do
    if grep -q "Waiting on http://localhost:$port" "$LOG_FILE" 2>/dev/null; then
      ready_log=1
      break
    fi
    if ! pid_alive "$root"; then
      echo "expo exited before it was ready" >&2
      cat "$LOG_FILE" >&2 || true
      exit 1
    fi
    sleep 1
    i=$((i + 1))
  done
  if [ "$ready_log" -ne 1 ]; then
    echo "timed out waiting for Metro to listen on $url" >&2
    exit 1
  fi
  # Server output sends a client shell. The heading is rendered by the bundle, not this HTML.
  html="$(curl -fsS --max-time 180 "$url/" || true)"
  if ! printf '%s' "$html" | grep -q 'id="root"'; then
    echo "server answered, but the home page was not usable at $url/" >&2
    tail -n 40 "$LOG_FILE" >&2 || true
    exit 1
  fi
  if ! printf '%s' "$html" | grep -q "entry.bundle"; then
    echo "home page is missing the web bundle at $url/" >&2
    exit 1
  fi
  if printf '%s' "$html" | grep -q "Metro error"; then
    echo "home page bundle failed at $url/" >&2
    tail -n 40 "$LOG_FILE" >&2 || true
    exit 1
  fi
  echo "url=$url"
  echo "root_pid=$root"
  echo "expo_version=$(expo_version)"
}

cmd_doctor() {
  require_state
  root="$(read_pid)"
  port="$(tr -d '[:space:]' < "$PORT_FILE")"
  url="$(tr -d '[:space:]' < "$URL_FILE")"
  version="$(expo_version)"
  if ! pid_alive "$root"; then
    echo "recorded pid $root is not running" >&2
    exit 1
  fi
  listen="$(listener_pid "$port" || true)"
  if [ -z "$listen" ]; then
    echo "nothing is listening on port $port" >&2
    exit 1
  fi
  if ! is_descendant "$listen" "$root"; then
    echo "port $port is owned by pid $listen, which is not our server pid $root" >&2
    exit 1
  fi
  html="$(curl -fsS --max-time 180 "$url/" || true)"
  if ! printf '%s' "$html" | grep -q 'id="root"'; then
    echo "home page is not usable at $url/" >&2
    exit 1
  fi
  if ! printf '%s' "$html" | grep -q "entry.bundle"; then
    echo "web bundle is missing at $url/" >&2
    exit 1
  fi
  if printf '%s' "$html" | grep -q "Metro error"; then
    echo "home page bundle failed at $url/" >&2
    exit 1
  fi
  echo "ok"
  echo "url=$url"
  echo "port=$port"
  echo "root_pid=$root"
  echo "listener_pid=$listen"
  echo "expo_version=$version"
  echo "bind=::1"
}

cmd_url() {
  require_state
  tr -d '[:space:]' < "$URL_FILE"
  echo
}

cmd_cleanup() {
  if [ ! -f "$PID_FILE" ]; then
    echo "no verification server recorded"
    exit 0
  fi
  root="$(read_pid)"
  port=""
  if [ -f "$PORT_FILE" ]; then
    port="$(tr -d '[:space:]' < "$PORT_FILE")"
  fi
  if [ -n "$port" ]; then
    listen="$(listener_pid "$port" || true)"
    if [ -n "$listen" ] && ! is_descendant "$listen" "$root"; then
      echo "refusing to kill pid $listen on port $port; it is not our server" >&2
      exit 1
    fi
  fi
  if pid_alive "$root"; then
    kill_tree "$root"
  fi
  i=0
  while [ "$i" -lt 20 ]; do
    if ! pid_alive "$root"; then
      break
    fi
    sleep 0.25
    i=$((i + 1))
  done
  if pid_alive "$root"; then
    kill -9 "$root" 2>/dev/null || true
  fi
  rm -rf "$RUN_DIR"
  mkdir -p "$ARTIFACTS_DIR"
  echo "stopped verification server"
  echo "artifacts=$ARTIFACTS_DIR"
}

usage() {
  echo "usage: control-reppie launch|doctor|url|cleanup" >&2
  exit 1
}

case "${1:-}" in
  launch) cmd_launch ;;
  doctor) cmd_doctor ;;
  url) cmd_url ;;
  cleanup) cmd_cleanup ;;
  *) usage ;;
esac
